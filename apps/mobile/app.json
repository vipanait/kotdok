{
  "expo": {
    "name": "Лапка",
    "slug": "lapka",
    "owner": "vitaliypanaits-team",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/295bb623-316a-4f43-8c1a-8fe0f79688ec"
    },
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "lapka",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "my.lapka.app",
      "appleTeamId": "KAY8S7KK98",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "my.lapka.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/android-icon-foreground.png",
        "monochromeImage": "./assets/brand/android-icon-foreground.png",
        "backgroundColor": "#EB8124"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lapka uses the photos you pick for your pet's profile picture and for a symptom check. Symptom check photos are deleted right after the analysis.",
          "cameraPermission": "Lapka uses the camera to take your pet's profile picture or a photo of a symptom for a check. Symptom check photos are deleted right after the analysis.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/android-orientation",
      "expo-image"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "295bb623-316a-4f43-8c1a-8fe0f79688ec"
      }
    }
  }
}
