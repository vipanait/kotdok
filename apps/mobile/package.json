{
  "name": "@lapka/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "export:android": "expo export --platform android --output-dir dist/android",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@lapka/contracts": "*",
    "@lapka/shared": "*",
    "expo": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.4",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react"
      ]
    }
  }
}
