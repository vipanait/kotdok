# Environment for the unit suite (`npm run test --workspace @lapka/web`).
#
# Those tests mock every dependency, so nothing here reaches a real service.
# The values point at the staging Supabase project rather than at a made-up host
# so that a test which accidentally starts making a real call fails against
# staging instead of silently succeeding — or worse, hitting production.
#
# The integration suite does NOT read this file: it uses .env.integration and
# refuses any target that is not the local stack.
#
# Only public values belong here. The anon key is a client key that ships in
# every page load; the service role key must never be committed and stays a
# placeholder — provide the real one through the environment when a task needs
# it.

NODE_ENV=test

NEXT_PUBLIC_SUPABASE_URL=https://rclnsbivyulqmvujiopv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJjbG5zYml2eXVscW12dWppb3B2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg2NDMzNzUsImV4cCI6MjEwNDIxOTM3NX0.fujqL7yWocKpf0WT2C63vFEVSyJeICbY6uLWqb5V2z0

SUPABASE_SERVICE_ROLE_KEY=placeholder-not-a-real-key
OPENAI_API_KEY=placeholder-not-a-real-key
DUMMY_WEBHOOK_SECRET=placeholder-not-a-real-secret

NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
