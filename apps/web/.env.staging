# Local development against the staging Supabase project.
#
# Used by `npm run dev:staging --workspace @lapka/web`, which hands these values
# to `next dev` through the environment. That matters: Next does not overwrite
# variables already set, so `.env.local` — which holds production credentials —
# cannot bleed through. Every variable the app reads is therefore listed here,
# even the ones it does not need, so none of them can fall back to production.
#
# The mobile app calls http://localhost:3000, so this is what its product
# screens talk to. The phone signs in against staging; the API has to match.
#
# Only public values belong here. The service role key goes in
# .env.staging.local, which is not committed.

NEXT_PUBLIC_SUPABASE_URL=https://rclnsbivyulqmvujiopv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJjbG5zYml2eXVscW12dWppb3B2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODg2NDMzNzUsImV4cCI6MjEwNDIxOTM3NX0.fujqL7yWocKpf0WT2C63vFEVSyJeICbY6uLWqb5V2z0

NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Supplied by .env.staging.local. The dev script refuses to start while this is
# a placeholder, and refuses a key belonging to a different project.
SUPABASE_SERVICE_ROLE_KEY=placeholder-not-a-real-key

# Symptom analysis needs a real key; without one the analysis route fails and
# everything else still works. Put a real value in .env.staging.local to use it.
OPENAI_API_KEY=placeholder-not-a-real-key

# Notifications and payments are not part of what the mobile app exercises, and
# a placeholder here is deliberate: it keeps production's real secrets out.
TELEGRAM_BOT_TOKEN=placeholder-not-a-real-secret
TELEGRAM_APPROVAL_CHAT_ID=placeholder-not-a-real-chat
TELEGRAM_WEBHOOK_SECRET=placeholder-not-a-real-secret
DUMMY_WEBHOOK_SECRET=placeholder-not-a-real-secret
ENABLE_DUMMY_PAYMENTS=false
