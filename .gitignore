# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/
dist/

# expo / react native
.expo/
.expo-shared/
apps/mobile/android/
apps/mobile/ios/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.test

# Public staging values for `dev:staging`; the service key lives in
# .env.staging.local, which stays ignored by the rule above.
!.env.staging
# Local Supabase stack only: fixed public CLI keys, no secrets.
!.env.integration
# Expo client configuration: EXPO_PUBLIC_* values ship in the bundle anyway.
!apps/mobile/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.idea/

.orch/
