# Integration-test stack: the disposable local Supabase started by `supabase start`.
#
# These are the fixed development keys the Supabase CLI ships for every local
# stack. They are public, identical on every machine, and grant nothing outside
# 127.0.0.1. No production or staging value belongs in this file.
#
# The reset guard (tests/support/db-guard.ts) additionally refuses any target
# that is not 127.0.0.1:54322 / 127.0.0.1:54321, so this opt-in cannot reach a
# hosted project even if the URLs below are edited by mistake.

TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
TEST_SUPABASE_URL=http://127.0.0.1:54321
TEST_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
TEST_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
ALLOW_DESTRUCTIVE_DB_RESET=true
