{
  "name": "lapka.my",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react-native": "0.86.3",
    "@babel/core@7": "^7.29.7",
    "@humanfs/node": "^0.16.8",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@5": "^5.0.9",
    "js-yaml@4": "^4.3.2",
    "vite@8": "^8.2.2",
    "ws@8": "^8.21.3"
  },
  "scripts": {
    "lint": "npm run lint --workspace @lapka/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @lapka/web",
    "test:integration": "npm run test:integration --workspace @lapka/web",
    "build": "npm run build --workspace @lapka/web",
    "dev": "npm run dev --workspace @lapka/web",
    "test:ci-routing": "node --test .github/scripts/changed-groups.test.mjs"
  }
}
